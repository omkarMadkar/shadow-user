# Shadow Sentinel — MongoDB Configuration
# Fill in your MongoDB Atlas free-tier connection string below.
# Format: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/
#
# Steps to get your URI:
#   1. Go to https://cloud.mongodb.com → free M0 cluster
#   2. Create a DB user + whitelist IP 0.0.0.0/0
#   3. Click Connect → Drivers → Python → copy the URI
#   4. Replace <password> with your actual password

MONGO_URI=PASTE_YOUR_MONGO_URI
MONGO_DB=PASTE_YOUR_MONGO_DB_NAME
